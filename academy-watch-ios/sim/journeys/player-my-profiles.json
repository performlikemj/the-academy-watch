{
  "version": "1.3",
  "name": "player-my-profiles",
  "settle_ms": 400,
  "settle_timeout_ms": 8000,
  "fixture_evidence": {
    "offered_inputs": [
      {
        "claim": "Player is a valid simulator home experience value.",
        "source": "AcademyWatch/Features/Home/PlayerClubModels.swift:3-5"
      }
    ],
    "server_state": [
      {
        "claim": "The player fixture supplies an approved synthetic local profile claim.",
        "source": "AcademyWatch/Features/Home/PlayerClubExperienceFixtures.swift:84-88"
      }
    ],
    "layout": [
      {
        "claim": "Player Home exposes My profiles and the destination has a stable identifier.",
        "source": "AcademyWatch/Features/Home/PlayerHomeView.swift:167-174"
      }
    ],
    "preflight": {
      "kind": "none",
      "note": "The final-code checkpoint resolves all profile reads through the offline fixture seam."
    }
  },
  "steps": [
    {
      "id": "launch-player-home",
      "expectation": "Home launches for the Player experience.",
      "checkpoint": true,
      "action": {
        "launch": {
          "args": [
            "-resetExperienceRole",
            "-experienceRole",
            "player",
            "-experienceFixture",
            "player"
          ],
          "env": {}
        }
      },
      "settle": {
        "waitFor": {
          "id": "home-my-profiles"
        },
        "timeout": 8
      }
    },
    {
      "id": "home-selected-for-player",
      "expectation": "Home exposes the stable selected state for the Player experience.",
      "action": {
        "assertSelected": {
          "id": "tab-bar-home",
          "timeout": 4
        }
      }
    },
    {
      "id": "my-profiles-action-visible",
      "expectation": "My profiles is visible on Player Home.",
      "action": {
        "assertVisible": {
          "id": "home-my-profiles"
        }
      }
    },
    {
      "id": "open-my-profiles",
      "expectation": "The My profiles action opens its destination.",
      "action": {
        "tap": {
          "id": "home-my-profiles"
        }
      },
      "settle": {
        "waitFor": {
          "id": "my-profiles"
        },
        "timeout": 8
      }
    },
    {
      "id": "my-profiles-screen-visible",
      "expectation": "The fixture-backed My profiles screen is visible.",
      "action": {
        "assertVisible": {
          "id": "my-profiles"
        }
      }
    }
  ]
}

{
  "version": "1.3",
  "name": "player-first-run-chooser",
  "settle_ms": 400,
  "settle_timeout_ms": 8000,
  "fixture_evidence": {
    "offered_inputs": [
      {
        "claim": "The none role removes stored experience state before RootTabView is built.",
        "source": "AcademyWatch/Features/Home/PlayerClubModels.swift:44-47"
      }
    ],
    "server_state": [
      {
        "claim": "The player fixture is a local signed-in state and does not choose an experience role.",
        "source": "AcademyWatch/App/RootTabView.swift:96-101"
      }
    ],
    "layout": [
      {
        "claim": "The first-run Home chooser renders all ExperienceRole cases with stable identifiers.",
        "source": "AcademyWatch/Features/Home/PlayerHomeView.swift:58-67"
      }
    ],
    "preflight": {
      "kind": "none",
      "note": "The final-code checkpoint keeps role reset and fixture mode as separate simulator launch arguments."
    }
  },
  "steps": [
    {
      "id": "launch-without-role",
      "expectation": "The first-run Home chooser appears.",
      "checkpoint": true,
      "action": {
        "launch": {
          "args": [
            "-resetExperienceRole",
            "-experienceRole",
            "none",
            "-experienceFixture",
            "player"
          ],
          "env": {}
        }
      },
      "settle": {
        "waitFor": {
          "id": "home-role-player"
        },
        "timeout": 8
      }
    },
    {
      "id": "player-choice-visible",
      "expectation": "Player is offered as a Home experience.",
      "action": {
        "assertVisible": {
          "id": "home-role-player"
        }
      }
    },
    {
      "id": "club-choice-visible",
      "expectation": "Club is offered as a Home experience.",
      "action": {
        "assertVisible": {
          "id": "home-role-club"
        }
      }
    },
    {
      "id": "scout-choice-visible",
      "expectation": "Scout is offered as a Home experience.",
      "action": {
        "assertVisible": {
          "id": "home-role-scout"
        }
      }
    }
  ]
}

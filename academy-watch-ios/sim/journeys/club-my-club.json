  "settle_timeout_ms": 8000,
  "fixture_evidence": {
    "offered_inputs": [
      {
        "claim": "Club is a valid simulator home experience value.",
        "source": "AcademyWatch/Features/Home/PlayerClubModels.swift:3-5"
      }
    ],
    "server_state": [

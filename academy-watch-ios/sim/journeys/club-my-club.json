    },
    {
      "id": "home-selected-for-club",
      "expectation": "Home is selected for the Club experience.",
      "action": {
        "assertSelected": {
          "id": "tab-bar-home",
          "timeout": 4
        }
      }
    },
    {
      "id": "my-club-action-visible",
      "expectation": "My club is visible on Club Home.",
      "action": {
        "assertVisible": {
          "id": "home-my-club"
        }
      }
    }
  ]
